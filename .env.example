# Jarvis - environment configuration TEMPLATE
#
# ---------------------------------------------------------------------
# SETUP (one time)
# ---------------------------------------------------------------------
#   1. Copy this file to ".env" in the same folder:
#
#          copy .env.example .env
#
#   2. Fill in the sections below that you actually use. Every section
#      is optional and independent - Jarvis boots with none of them set,
#      and simply says so when you ask for a feature it can't reach.
#
#   3. Restart Jarvis:  .venv\Scripts\python main.py
#
#   Format: no quotes, no spaces around the "=", one value per line.
#
# ---------------------------------------------------------------------
# IMPORTANT
# ---------------------------------------------------------------------
#   * Commit THIS file (.env.example). Never commit ".env" - it holds
#     live credentials. .gitignore already excludes it.
#   * If a credential is ever pasted into a chat, screenshot, or commit,
#     rotate it. Secrets cannot be un-leaked.
#   * Wake word detection and speech-to-text run offline and need
#     nothing here. Text-to-SPEECH is now a hybrid - see section 1b.


# =====================================================================
# 1. CONVERSATIONAL BRAIN / SUPERVISOR (Module 5) - optional
# =====================================================================
#   Jarvis supports two LLM providers and needs at most one of them.
#   Without either, it still opens projects, runs workflows, and queries
#   the database by voice - it just can't answer open questions.
#
#   Provider selection, in order:
#     1. ANTHROPIC_API_KEY set  -> Anthropic Claude
#     2. otherwise GEMINI_API_KEY set -> Google Gemini
#
#   Gemini is also failed over to at runtime if Anthropic rejects the
#   key or the model. Transient errors (rate limits, network, 5xx) do
#   NOT fail over - the SDK retries those itself.

#   Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

#   Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

#   Override only if the default model name is retired.
#   Default: gemini-2.5-flash
GEMINI_MODEL=


# =====================================================================
# 1b. HYBRID VOICE ENGINE (Module 3) - optional
# =====================================================================
#   Speech OUT is a three-tier fallback chain, routed by reply length:
#
#     under 200 chars + ElevenLabs key -> ElevenLabs (premium, paid)
#     200 chars or more, or no key     -> Edge-TTS   (neural, free)
#     no network / edge-tts missing    -> pyttsx3    (offline, robotic)
#
#   Each tier falls through to the next on any failure, so none of the
#   settings below are required. Speech IN (Vosk) is always offline.

#   Key: https://elevenlabs.io/app/settings/api-keys
#   Leave empty to skip the premium tier entirely.
ELEVENLABS_API_KEY=

#   Premium voice, by display name. Built-in British males: George
#   (warm, mature) or Callum (younger, gravelly). Any voice in your
#   ElevenLabs library works - it is looked up by name at startup.
#   Default: George
ELEVENLABS_VOICE=

#   Default: eleven_turbo_v2_5. Use eleven_flash_v2_5 for lower latency
#   or eleven_multilingual_v2 for higher quality.
ELEVENLABS_MODEL=

#   Character threshold that splits premium from free. Raise it to spend
#   more on ElevenLabs, lower it to spend less. Default: 200
TTS_PREMIUM_MAX_CHARS=

#   Free neural voice. Other British options: en-GB-ThomasNeural (male),
#   en-GB-SoniaNeural / en-GB-LibbyNeural (female).
#   Default: en-GB-RyanNeural
EDGE_TTS_VOICE=

#   Edge-TTS prosody, in its own notation. Defaults: +0%, +0%, +0Hz
EDGE_TTS_RATE=
EDGE_TTS_VOLUME=
EDGE_TTS_PITCH=

#   Set to 1 to disable BOTH cloud voices and restore the original
#   no-network-at-all behaviour, keeping only offline pyttsx3.
JARVIS_TTS_OFFLINE_ONLY=


# =====================================================================
# 1b. LISTENING SESSION (Module 8) - optional
# =====================================================================
#   Jarvis listens in two states: STANDBY (everything discarded unless
#   it contains a wake phrase) and ACTIVE (every utterance is a command,
#   no wake word needed). An ACTIVE session ends itself after a stretch
#   of silence.
#
#   JARVIS_WAKE_BACKEND - how STANDBY spots the wake phrase:
#     vosk          (default) offline transcription matched against
#                   session_manager.WAKE_PHRASES. Knows "hey jarvis",
#                   "jarvis", "wake up", ... and needs no extra model.
#     openwakeword  the dedicated always-on ONNX model. Lower CPU and
#                   fewer false triggers, but only the one phrase it was
#                   trained on, and the model must be downloaded first
#                   (python train_jarvis.py).

JARVIS_WAKE_BACKEND=vosk

#   Seconds of silence that end an ACTIVE session. The clock is paused
#   while a command runs, so a slow workflow or a long answer never
#   times the session out. Default 15.

JARVIS_ACTIVE_TIMEOUT=15

#   ACTIVE-mode transcription (faster-whisper). STANDBY always uses
#   Vosk - it is cheap enough to run against an open mic for hours -
#   and ACTIVE hands off to Whisper, which understands Thai, English,
#   and the two mixed together in one sentence.
#
#   JARVIS_WHISPER_MODEL    tiny | base | small (default) | medium | large-v3
#                           "small" is ~460 MB and the sweet spot for
#                           Thai; drop to "base" on a slow machine.
#   JARVIS_WHISPER_DEVICE   auto (default) | cpu | cuda
#   JARVIS_WHISPER_COMPUTE  auto (default: int8 on CPU, float16 on GPU)
#   JARVIS_WHISPER_LANGUAGE LEAVE BLANK to auto-detect. Setting this to
#                           en or th pins every command to that language
#                           and breaks Thai-English code-switching.
#   JARVIS_WHISPER_PROMPT   overrides the bilingual hint that biases the
#                           decoder towards this assistant vocabulary.
#   JARVIS_VAD_THRESHOLD    blank = calibrate against the room at each
#                           listen. Set an RMS integer (e.g. 700) only if
#                           a noisy room keeps triggering false starts.
#
#   Download the model once with:  python whisper_manager.py

JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_DEVICE=auto
JARVIS_WHISPER_COMPUTE=auto
JARVIS_WHISPER_LANGUAGE=

#   Speed lever. Measured on CPU (int8) for a ~3 second command:
#     small   ~6.5s decode, Thai transcribed exactly     (default)
#     base    ~2.0s decode, Thai noticeably degraded
#   A GPU (JARVIS_WHISPER_DEVICE=cuda) makes both far faster.
#   JARVIS_WHISPER_BEAM=1 shaves ~10% off either.


# =====================================================================
# 2b. ON-DEMAND VISION (Module 11) - optional
# =====================================================================
#   Nothing is captured in the background. When you ask a question about
#   the screen ("what am I looking at?"), ONE screenshot is taken at
#   that moment, sent to the vision model, and dropped. Nothing is
#   written to disk, and nothing is kept between questions.
#
#   JARVIS_VISION           1 (default) or 0 to refuse screen capture
#   JARVIS_VISION_MONITOR   1 = primary (default), 2 = second screen,
#                           0 = all monitors stitched together

JARVIS_VISION=1


# =====================================================================
# 2c. MODEL ROUTING (Module 5) - no configuration needed
# =====================================================================
#   Jarvis picks a model per question. Short transactional commands go
#   to the fast tier (claude-sonnet-5); heavy requests - "design",
#   "analyse this codebase", "think hard" - are escalated to the
#   reasoning tier (claude-opus-5) automatically. The console prints
#   which tier each question took and why.
#
#   To change the tiers, edit MODEL / MODEL_DEEP in llm_brain.py.


# =====================================================================
# 2d. SUBTRACK DEV ENVIRONMENT (OS Orchestrator) - optional
# =====================================================================
#   Spoken as: "start work" / "open Subtrack" / "start the environment"
#
#   Jarvis starts the Docker container, then launches the FastAPI
#   backend and the Next.js frontend, each in ITS OWN console window so
#   their logs stay readable and closing Jarvis does not kill them.
#
#   Point SUBTRACK_FRONTEND_PATH at the folder holding package.json, and
#   SUBTRACK_BACKEND_PATH at the folder holding the FastAPI app.
#
#   DO NOT PUT QUOTES AROUND THE PATH. Inside double quotes the
#   backslashes are read as escape sequences, so "C:\temp\api" arrives
#   with a TAB in it and the folder is never found. Write it bare:
#
#       SUBTRACK_BACKEND_PATH=C:\Users\you\subtrack\api      <- correct
#       SUBTRACK_BACKEND_PATH="C:\Users\you\subtrack\api"    <- breaks
#
#     SUBTRACK_BACKEND_PATH   runs: python -m uvicorn main:app --reload
#     SUBTRACK_FRONTEND_PATH  runs: npm run dev
#
#   The backend is started with the project's OWN virtual environment
#   (venv/, .venv/ or env/ inside SUBTRACK_BACKEND_PATH) when it has
#   one - uvicorn and the app's dependencies live there, not in Jarvis's
#   interpreter. Without one it falls back to the system python and says
#   so, which is usually why a backend window dies with
#   "No module named uvicorn".
#
#   Leave them empty and the tool says which one is missing rather than
#   starting half an environment.

SUBTRACK_FRONTEND_PATH=
SUBTRACK_BACKEND_PATH=

#   The Docker container to wake up. Defaults to n8n_stable.

SUBTRACK_DOCKER_CONTAINER=n8n_stable

#   What uvicorn serves. Defaults to main:app - set this only if the
#   FastAPI app lives somewhere else, e.g. app.main:app.

SUBTRACK_BACKEND_APP=main:app


# =====================================================================
# 2e. TRIP PLANNER (Planner Agent + sub-agents) - optional
# =====================================================================
#   Spoken as: "plan a trip to <destination>" (Jarvis will ask where
#   you're travelling FROM if you don't say - see llm_brain.py)
#
#   Trip Planner is a separate application from Subtrack - deliberately
#   decoupled so Jarvis does not grow one monolithic "the app" it talks
#   to. generate_trip_plan_async (plugins/trip_planner.py) gathers real
#   data from sub-agents and hands it to a Gemini Planner Agent:
#
#     Open-Meteo           weather forecast for the destination - NO KEY
#                           NEEDED, nothing below configures it
#     Google Geocoding  )
#     Google Places     )   need GOOGLE_MAPS_API_KEY below
#     Gemini (planning)     needs GEMINI_API_KEY - see section 1 above.
#                           The Planner Agent reuses that SAME key,
#                           through the same google-genai SDK
#                           llm_brain.py's Gemini fallback uses; it is
#                           not a second, separate credential.
#
#   A GROUP trip works differently: check_poll_status_async and
#   finalize_trip_plan_async (same file) read an existing consensus
#   poll's real votes over HTTP (see TRIP_PLANNER_APP_URL below) rather
#   than gathering data from the sub-agents above, and finalize's
#   Planner Agent call prefers ANTHROPIC_API_KEY over GEMINI_API_KEY at
#   its high-effort tier - see "PROVIDER SELECTION" in
#   _run_finalization_agent's docstring.
#
#   PRIVACY: the trip's starting location is passed into
#   generate_trip_plan_async as a plain argument, used only to build the
#   spoken acknowledgement, and is never sent to Gemini, written to a
#   file, a database, or a log line - see "WHY starting_location NEVER
#   REACHES GEMINI" at the top of plugins/trip_planner.py (it used to be
#   sent to Gemini; a live test showed the model echoing the raw address
#   back into the itinerary text, so that was removed) before changing
#   how it flows.
#
#   Get a Maps key at https://console.cloud.google.com/google/maps-apis
#   and enable, on that same key: Geocoding API and Places API. Leave it
#   empty and the tool reports which lookups are unavailable rather than
#   guessing at places or coordinates.

GOOGLE_MAPS_API_KEY=

#   TRIP_PLANNER_APP_PATH is a placeholder for when the OS Orchestrator
#   is upgraded to open specific apps based on context - it will point
#   at the Trip Planner app's local path or web URL once that app
#   exists. Leave empty until then.

TRIP_PLANNER_APP_PATH=

#   TRIP_PLANNER_APP_URL, unlike the placeholder above, IS read today -
#   by finalize_trip_plan_async (plugins/trip_planner.py), which GETs
#   {TRIP_PLANNER_APP_URL}/api/poll/<trip_id> from the standalone Trip
#   Planner app (TripPlanner_Web) to read a consensus poll's real votes
#   before generating the final itinerary from them. Defaults to
#   http://localhost:3000, matching `next dev`'s default port - only set
#   this if that app is deployed somewhere else.

TRIP_PLANNER_APP_URL=

#   TRIP_API_SECRET_KEY - the shared HMAC secret finalize_trip_plan_async
#   (plugins/trip_planner.py's _fetch_poll_data) signs its GET request
#   with, since TripPlanner_Web's GET /api/poll/[id] now rejects unsigned
#   requests. Must hold the EXACT SAME value as TripPlanner_Web's
#   .env.example entry API_SECRET_KEY - different variable name, same
#   secret. Leave empty and every poll fetch is rejected with 401, which
#   finalize_trip_plan_async reports as "couldn't reach the Trip Planner
#   app" over LINE.

TRIP_API_SECRET_KEY=


# =====================================================================
# 2. n8n AUTOMATION (Module 6) - optional
# =====================================================================
#   Spoken as: "log my Netflix subscription, fifteen dollars,
#              entertainment"                 -> subtrack log workflow
#              "run automation" / "trigger workflow" -> default workflow
#
#   START HERE: N8N_SUBTRACK_WEBHOOK is the Subtrack logging workflow -
#   Jarvis's primary automation. Jarvis extracts the fields out of what
#   you said (item_name, amount, category, ...) and POSTs them as JSON
#   for n8n to write into the Subtrack database. Set this one and
#   "log my Netflix subscription, fifteen dollars" works.
#
#   Use the PRODUCTION webhook URL from the n8n Webhook node, not the
#   test URL - the test URL only listens while the n8n editor is open.
#   The workflow must be ACTIVE, or n8n answers 404.
#
#   TREAT THESE URLS AS PASSWORDS. Anyone who has one can run the
#   workflow. Prefer a Header Auth credential on the Webhook node and
#   set N8N_WEBHOOK_TOKEN below to match.

N8N_SUBTRACK_WEBHOOK=https://your-n8n-host/webhook/replace-with-your-uuid

#   Optional. The workflow "run automation" fires when no workflow is
#   named. If you leave it empty and only ONE webhook above is set,
#   "run automation" uses that one.

N8N_WEBHOOK_URL=

#   ADDITIONAL WORKFLOWS (optional), without touching the code: any
#   variable named N8N_WEBHOOK_<NAME> registers a workflow called
#   "<name>", underscores read as spaces - so N8N_WEBHOOK_DAILY_REPORT
#   answers to "run workflow daily report". For a name your voice will
#   actually say often, add it to WORKFLOW_ENV_VARS in n8n_trigger.py
#   instead, where it can carry aliases for STT mishearings.
#
# N8N_WEBHOOK_DAILY_REPORT=

# Optional shared secret. Sent as "Authorization: Bearer <token>";
# match it with a Header Auth credential on the n8n Webhook node.
N8N_WEBHOOK_TOKEN=

# Optional. Seconds to wait for a workflow to answer (default 5).
# Keep this short: Jarvis is a voice loop, and a long silence reads as
# a crash. A slow workflow should respond to the webhook immediately
# and then run asynchronously, rather than have this number raised.
N8N_WEBHOOK_TIMEOUT=5


# =====================================================================
# 3. POSTGRESQL / DEMP DATABASE (Module 7) - optional, READ-ONLY
# =====================================================================
#   Spoken as: "check demp database status" -> count of energy_logs
#              "check database"             -> connectivity only
#              "how many farmers"           -> count of farmers
#
#   Jarvis only ever runs the statements registered in SAFE_QUERIES in
#   db_connector.py, over a read-only session. Those statements name
#   `energy_logs` and `farmers` as placeholders - edit them to match the
#   real DEMP schema. Until then, "check database" still works: SELECT 1
#   needs no tables, and a missing table is reported as such rather than
#   as a connection failure.
#
#   USE A DEDICATED READ-ONLY ROLE. The code refuses to write, but the
#   database should refuse too:
#
#       CREATE ROLE jarvis_ro LOGIN PASSWORD 'change-me';
#       GRANT CONNECT ON DATABASE yourdb TO jarvis_ro;
#       GRANT USAGE ON SCHEMA public TO jarvis_ro;
#       GRANT SELECT ON ALL TABLES IN SCHEMA public TO jarvis_ro;
#
#   Leave DB_NAME or DB_USER empty to disable database features.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=demp
DB_USER=jarvis_ro
DB_PASS=your-read-only-password

# disable | allow | prefer | require | verify-ca | verify-full
# Use "require" or stronger for any database not on this machine.
DB_SSLMODE=prefer

# What Jarvis calls this database out loud, e.g. "I am currently unable
# to connect to the DEMP database." Optional; defaults to DEMP.
DB_LABEL=DEMP

# On import, db_connector creates the two tables Jarvis owns if they are
# missing - chat_history and action_logs - so a fresh install needs no
# manual setup. CREATE TABLE IF NOT EXISTS never touches an existing
# table, so this is safe to leave on.
#
#   Note that the SELECT-only role above cannot run it. Either create
#   the tables once as an owner, or grant jarvis_ro what it needs:
#
#       GRANT CREATE ON SCHEMA public TO jarvis_ro;
#       GRANT INSERT ON action_logs TO jarvis_ro;
#       GRANT USAGE ON SEQUENCE action_logs_id_seq TO jarvis_ro;
#
# Set to 0 to skip the bootstrap - the right setting once the schema is
# managed elsewhere. Jarvis still starts and still answers either way;
# a failure here is printed and nothing more.
DB_AUTO_INIT=1


# =====================================================================
# 4. LINE NOTIFICATIONS - optional
# =====================================================================
#   Spoken as: "remind me to call the supplier at 5"
#              "let me know when that finishes"
#              "send me a summary of today's spending"
#
#   Jarvis pushes the message via the LINE Messaging API's push
#   endpoint, straight to your phone. This is a real outward-facing
#   action - like the n8n webhook above - so it asks you to confirm out
#   loud before anything is sent.
#
#   SETUP (LINE Developers console, https://developers.line.biz/console/):
#     1. Create a Messaging API channel (or use an existing one).
#     2. Channel settings -> Messaging API -> issue a long-lived
#        "Channel access token" -> LINE_CHANNEL_ACCESS_TOKEN below.
#     3. Add the channel's official account as a friend on your phone.
#     4. Get YOUR user ID, not the channel's: the simplest way is a
#        webhook - point "Webhook URL" at any endpoint that logs the
#        request body, send the bot a message, and read `source.userId`
#        from the event -> LINE_USER_ID below.
#
#   TREAT THE ACCESS TOKEN AS A PASSWORD. Anyone who has it can send
#   messages as your bot to anyone who has friended it.
#
#   Leave either value empty to disable the tool; Jarvis still starts,
#   and the tool reports plainly that it isn't configured rather than
#   failing silently.

LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
