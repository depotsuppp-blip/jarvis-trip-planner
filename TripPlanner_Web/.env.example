# Trip Planner Web - environment configuration TEMPLATE
#
# Copy this file to ".env.local" (or ".env") in this folder and fill in the
# values below. Both are optional in the sense that the app still builds and
# runs without them - the features they gate simply report why they can't
# work, per the errors already coded in the relevant routes/pages.

# LINE LIFF app id (LINE Developers console -> your channel -> LIFF tab).
# Read client-side by app/trip/poll/[id]/page.tsx to sign voters in with
# their LINE profile. Must be prefixed NEXT_PUBLIC_ so Next.js exposes it
# to the browser bundle - it is not a secret, it identifies the LIFF app.
NEXT_PUBLIC_LIFF_ID=

# Jarvis Python backend's webhook URL that starts itinerary generation for
# a locked poll. Read server-side only by app/api/trigger-jarvis/route.ts,
# which proxies { trip_id } to this URL - never exposed to the browser.
JARVIS_WEBHOOK_URL=

# LINE channel id (LINE Developers console -> your channel -> Basic settings
# -> Channel ID) - NOT the LIFF id above. Read server-side only by
# app/api/poll/[id]/route.ts's POST handler to verify a voter's LIFF ID
# token against https://api.line.me/oauth2/v2.1/verify (checked as the
# token's `aud` claim). Leave empty and vote submission always answers 401.
LINE_CHANNEL_ID=

# Postgres (Neon) connection string used by lib/store.ts via Prisma to
# persist poll votes and draft board text - see prisma/schema.prisma.
# Required in every environment: Vercel's filesystem is read-only outside
# /tmp, so there is no local-file fallback anymore. Use the pooled
# ("-pooler") connection string from the Neon dashboard's Connection
# Details panel. If this Neon project also hosts unrelated tables for
# another app (e.g. Jarvis's own DEMP tables), that's fine - Prisma here
# only ever touches the PollVote/TripDraft tables via hand-applied
# migrations, never a destructive `prisma db push`.
DATABASE_URL=

# Anthropic API key used by app/api/trigger-jarvis/route.ts's two-stage
# itinerary generation ("Lock & Generate Plan") - a Haiku call to plan the
# day structure, then (after grounding it in real venues via
# GOOGLE_MAPS_API_KEY below) a second Haiku call to write the final plan.
# Leave empty and locking a poll fails with a clear "not configured" error
# rather than a generic 500.
ANTHROPIC_API_KEY=

# Google Maps Platform API key, used by app/api/trigger-jarvis/route.ts's
# lib/places.ts (Stage 1.5) to ground itinerary venue names in real search
# results instead of letting the model invent them, AND by lib/routes.ts
# (Stage 2.5) to attach real travel-time/distance estimates between each
# day's consecutive stops, with a dynamically chosen mode (walk/transit/
# drive - see lib/routes.ts's pickTravelMode) per leg. Also used by
# app/api/trip/alternative/route.ts's Nearby Search for a live, in-the-
# moment replacement stop. Needs TWO separate products enabled on the
# Google Cloud project (Console -> APIs & Services -> Library), even
# though this one key covers both:
#   "Places API (New)"  - DIFFERENT from the legacy "Places API" that
#                          plugins/trip_planner.py's Python side already
#                          uses with this same key. Covers both Text
#                          Search (Stage 1.5) and Nearby Search
#                          (/api/trip/alternative).
#   "Routes API"         - DIFFERENT from the legacy "Distance Matrix
#                          API". Only Compute Routes is used (one request
#                          per stop-to-stop leg), never Compute Route
#                          Matrix.
# Also needs billing active on that Google Cloud project - neither API
# has a meaningful free tier at this app's usage. Leave empty, or leave
# either API disabled/unbilled, and locking a poll fails outright
# (Places) or that leg simply shows no travel-time estimate (Routes,
# which degrades gracefully rather than failing generation - see
# lib/routes.ts's computeDayRoute).
GOOGLE_MAPS_API_KEY=

# WeatherAPI.com API key (https://www.weatherapi.com/, free tier
# available), read server-side only by lib/weather.ts and used by
# app/api/trigger-jarvis/route.ts to attach an average-temperature/
# condition summary for the locked trip's date window (shown on the poll
# page's "Weather" card). Leave empty and that card just shows
# "Unavailable" rather than failing plan generation - see
# lib/weather.ts's docstring, including its honest limitation that a
# trip planned far enough out can be beyond what this API forecasts at
# all, which also shows as "Unavailable" even with a valid key.
WEATHER_API_KEY=

# Shared HMAC secret that gates GET /api/poll/[id] - without it, anyone
# with a trip id could read that trip's poll votes. The only caller today
# is plugins/trip_planner.py's finalize_trip_plan_async, which signs its
# request with the SAME secret under the name TRIP_API_SECRET_KEY (see
# that file's .env.example entry) - both must hold the identical value.
# TREAT THIS AS A PASSWORD, same as N8N_WEBHOOK_TOKEN in the root
# .env.example. Generate one with, e.g.:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=
