# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# mock "database" for the Trip Planner foundation - see lib/store.ts.
# Generated at runtime; never source, and per-environment test data.
/.data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template itself, which documents every var this app
# reads (see that file's own header) and is meant to be committed and
# kept current - it holds no real secrets, just var names and comments.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
