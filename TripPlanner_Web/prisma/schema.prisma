generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// NextAuth.js (Auth.js) models - the exact shape @auth/prisma-adapter
// expects for a Postgres adapter. Field names/casing (emailVerified,
// providerAccountId, session_state, etc.) are load-bearing: the adapter
// reads/writes them by these exact names, not just by model name, so
// don't rename them to match this file's usual camelCase-everywhere
// style. See app/api/auth/[...nextauth]/route.ts and lib/auth.ts.
// ---------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  // Phase 2 social/personalization features - see their own model
  // docstrings below for why tripId isn't a hard foreign key.
  tripParticipations     TripParticipant[]
  swipeActions           UserSwipeAction[]
  sentFriendRequests     Friendship[]      @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]      @relation("FriendshipAddressee")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------
// Phase 2: social + personalization features
// ---------------------------------------------------------------------

// One row per (user, trip) a signed-in user has joined - lets the UI
// answer "who's in this trip" and, by joining across rows sharing a
// userId, "who have I traveled with before" (Past Trip Mates).
//
// tripId is a bare correlator string, the same convention Poll/PollVote/
// TripDraft above already use for tripId - deliberately NOT a
// `@relation` to TripDraft. A participant can join a trip before any
// TripDraft row exists (TripDraft is only written once draft text is
// saved or a consensus itinerary finishes generating - see TripDraft's
// and Poll.durationDays's docstrings above), so a hard foreign key here
// would reject that ordering instead of matching how trips actually get
// created.
model TripParticipant {
  id       String   @id @default(cuid())
  userId   String
  tripId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tripId])
  @@index([tripId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Explicit "Add Friend" relationship. A self-relation on User via two
// named relations (requester/addressee) rather than a single symmetric
// join table, since a request has a direction and a status until it's
// accepted - see FriendshipStatus above.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

enum SwipeAction {
  LIKE
  DISLIKE
}

// One row per (user, trip, place) swipe on the upcoming Tinder-style
// place-picker UI. A later swipe on the same (userId, tripId,
// googlePlaceId) is meant to replace this row (same "resubmission
// replaces the prior row" convention as PollVote.voterKey above), not
// append a duplicate - enforced here the same way, via @@unique.
//
// tripId is a bare correlator string, not a `@relation` to TripDraft -
// see TripParticipant's docstring above for why.
model UserSwipeAction {
  id            String      @id @default(cuid())
  userId        String
  tripId        String
  googlePlaceId String
  action        SwipeAction
  createdAt     DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tripId, googlePlaceId])
  @@index([tripId])
}

// One row per voter per trip. A resubmission (double-tap, or genuinely
// changing your mind) replaces the prior row rather than appending a
// duplicate - enforced by the database itself via @@unique([tripId,
// voterKey]) and addPollVote's upsert() in lib/store.ts, not just an
// application-level check-then-write, so two concurrent requests from
// the same voter can't race past each other into two rows.
model PollVote {
  id          String   @id @default(cuid())
  tripId      String
  name        String
  lineUserId  String   @default("")
  startDate   String   @default("")
  endDate     String   @default("")
  wishlist    String   @default("")
  vibes       String[] @default([])
  submittedAt DateTime @default(now())
  /// Client-generated UUID, persisted in the voter's browser localStorage
  /// (see anonVoterId: in app/trip/poll/[id]/page.tsx) - identifies a
  /// voter with no verified LINE session. Empty for a verified vote,
  /// where lineUserId is the identity instead.
  anonId      String   @default("")
  /// "line:<lineUserId>" or "anon:<anonId>" - whichever identity this
  /// row actually has - or a one-off "once:<random>" when neither is
  /// available (an old cached client, or localStorage unavailable), so
  /// that row never collides with anything and is simply never deduped.
  /// This, not lineUserId or anonId alone, is what @@unique enforces:
  /// both of those default to "" and every anonymous row would otherwise
  /// collide on lineUserId="" (and likewise every verified row on
  /// anonId=""), so neither column alone can carry a real DB constraint.
  voterKey    String

  @@unique([tripId, voterKey])
  @@index([tripId])
}

// One row per trip - the solo draft board's evolving text blob. Also
// doubles as storage for a locked consensus poll's generated itinerary
// (JSON-stringified) - see app/api/trigger-jarvis/route.ts.
model TripDraft {
  tripId    String   @id
  text      String
  updatedAt DateTime @updatedAt
}

// One row per trip that has been locked, or is currently being locked -
// see POST /api/trigger-jarvis. Absence of a row means "not locked yet
// and no generation in flight", same as PollVote/TripDraft's "no row =
// nothing yet" convention elsewhere in this schema.
model Poll {
  tripId              String    @id
  locked              Boolean   @default(false)
  lockedAt            DateTime?
  /// True while a paid Anthropic call for this trip is in flight - the
  /// claim a concurrent "Lock & Generate Plan" click checks before
  /// spending quota a second time. Set true by an atomic INSERT ...
  /// ON CONFLICT ... WHERE claim (claimPollForGeneration in
  /// lib/store.ts, since Prisma's upsert() has no conditional-update
  /// clause), cleared on both success (lockPoll) and failure
  /// (releasePollClaim) - see generatingStartedAt for what happens if
  /// neither ever runs.
  generating          Boolean   @default(false)
  /// When the current (or last) generation claim was taken. A claim
  /// older than the staleness window in lib/store.ts is treated as
  /// abandoned and reclaimable - guards against a serverless instance
  /// being killed mid-request (a platform-level timeout kill does not
  /// reliably run a `finally` block) leaving generating=true stuck
  /// forever with no request left to release it.
  generatingStartedAt DateTime?
  /// Always "" now - previously recorded the verified LINE user id of
  /// whoever triggered a generation, back when a LINE session was
  /// optionally attached to POST /api/trigger-jarvis. That route no
  /// longer accepts or resolves any LINE identity at all -
  /// adminTokenHash below is the sole authorization boundary for
  /// locking a poll now (see lib/adminToken.ts's verifyAdminToken).
  /// Left in place rather than dropped via a destructive column
  /// migration; safe to remove later.
  lockedByLineUserId  String    @default("")
  /// SHA-256 hex digest of this trip's admin token - never the raw
  /// token itself. Minted once, when the poll is created by voice (see
  /// plugins/trip_planner.py's _run_consensus_poll and POST
  /// /api/poll/[id]/admin-token, which is the only writer of this
  /// field), and checked by POST /api/trigger-jarvis
  /// (lib/adminToken.ts's verifyAdminToken) before "Lock & Generate
  /// Plan" is allowed to run. "" means no admin token was ever issued
  /// for this trip - verifyAdminToken treats that as "nobody can
  /// authorize this trip," never as "any token works."
  adminTokenHash      String    @default("")
  /// Requested trip length in days, captured once at poll-creation time
  /// (see POST /api/poll/[id]/admin-token, sent by
  /// plugins/trip_planner.py's _create_poll_admin_token right after the
  /// user's voice command specifies it). The source of truth for both
  /// the date-window search (lib/tripDates.ts's computeBestTripWindow)
  /// and the Stage 1 prompt's day count (app/api/trigger-jarvis/route.ts) -
  /// replaces an earlier ?days=<n> URL-param approach, which reset to
  /// the default on every page reload or friend link since nothing
  /// about it was ever persisted server-side. Lives on Poll rather than
  /// TripDraft: Poll already exists from the moment a trip is created
  /// (see adminTokenHash above), but TripDraft for a consensus trip
  /// doesn't exist until generation actually finishes writing one - too
  /// late, since Stage 1 needs this value BEFORE it generates anything.
  /// Defaults to 5 for a trip created before this field existed, or if
  /// the voice pipeline never sent a value - the same default this app
  /// always used.
  durationDays        Int       @default(5)
}

model action_logs {
  id          Int       @id @default(autoincrement())
  intent_name String    @db.VarChar(100)
  status      String    @db.VarChar(50)
  details     String?
  executed_at DateTime? @default(now()) @db.Timestamptz(6)
}

model chat_history {
  id         Int       @id @default(autoincrement())
  role       String    @db.VarChar(50)
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model energy_logs {
  id          Int       @id @default(autoincrement())
  chiller_id  String?   @db.VarChar(50)
  energy_kwh  Decimal?  @db.Decimal(10, 2)
  recorded_at DateTime? @default(now()) @db.Timestamptz(6)
}
