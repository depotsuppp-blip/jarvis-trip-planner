# --- Secrets ------------------------------------------------------------
# .env holds a live Anthropic API key. Never commit it.
# .env.example is the safe, checked-in template.
.env
*.key
# Credential files such as the Google service account key (GOOGLE_SERVICE_ACCOUNT_FILE in .env)
.secrets/

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Jarvis runtime artifacts -------------------------------------------
# Downloaded Vosk speech model (~70 MB, refetch with: python vosk_manager.py)
.models/

# Local session memory
memory.json

# Files people attach in the web hub's chat (saved by TripPlanner_Web/lib/uploads.ts, read by
# the brain's filesystem tool). Personal documents: never commit them.
uploads/

# llm_budget.py's daily token usage record
.data/

# Custom wake word training output
jarvis_training_output/
my_jarvis.yaml

# --- Impeccable design-review artifacts ---------------------------------
# Screenshots captured for the finish review (regenerated at will). The older
# swipe-era ones already committed stay tracked; new ones stay out of git.
.impeccable/review/

# Local MCP server list (may hold env values); the checked-in template is mcp_servers.example.json
mcp_servers.json
